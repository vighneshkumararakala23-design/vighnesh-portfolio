# AI_API_KEY or GEMINI_API_KEY: Server-side API key for Vercel Serverless AI Function
# Add this environment variable in your Vercel Project Settings > Environment Variables
AI_API_KEY="your_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://your-portfolio.vercel.app"
